<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Ekran startowy w kolorze tła gry (reszta Info.plist powstaje z ustawień buildu). -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>TloStartu</string>
	</dict>
	<!-- Pozwala na 120 klatek na sekundę na iPhonie z ekranem ProMotion (płynniejszy ruch osiołka). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
